{
  "info": {
    "_postman_id": "8f8c6c0e-5b8d-4d1e-9a8c-qaops-tp-2026",
    "name": "QAOps - Reqres API",
    "description": "QA OPS TP - API testing using Reqres. Covers GET, POST, PUT and DELETE operations with status code, JSON structure and response data validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://reqres.in/api",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET - Users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users?page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        },
        "description": "Retrieve the second page of users from Reqres."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response contains data array\", function () {",
              "    pm.expect(jsonData).to.have.property(\"data\");",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Response contains pagination information\", function () {",
              "    pm.expect(jsonData).to.have.property(\"page\");",
              "    pm.expect(jsonData).to.have.property(\"per_page\");",
              "    pm.expect(jsonData).to.have.property(\"total\");",
              "    pm.expect(jsonData).to.have.property(\"total_pages\");",
              "});",
              "",
              "pm.test(\"Users contain required fields\", function () {",
              "    if (jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0]).to.have.property(\"id\");",
              "        pm.expect(jsonData.data[0]).to.have.property(\"email\");",
              "        pm.expect(jsonData.data[0]).to.have.property(\"first_name\");",
              "        pm.expect(jsonData.data[0]).to.have.property(\"last_name\");",
              "    }",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "POST - Create User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Aymane Jemmaa\",\n    \"job\": \"Full Stack Developer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Create a new user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response contains created user data\", function () {",
              "    pm.expect(jsonData).to.have.property(\"name\");",
              "    pm.expect(jsonData).to.have.property(\"job\");",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "    pm.expect(jsonData).to.have.property(\"createdAt\");",
              "});",
              "",
              "pm.test(\"Name is correct\", function () {",
              "    pm.expect(jsonData.name).to.eql(\"Aymane Jemmaa\");",
              "});",
              "",
              "pm.test(\"Job is correct\", function () {",
              "    pm.expect(jsonData.job).to.eql(\"Full Stack Developer\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "PUT - Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Aymane Jemmaa\",\n    \"job\": \"Backend Developer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{{user_id}}"
          ]
        },
        "description": "Update an existing user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response contains updated user data\", function () {",
              "    pm.expect(jsonData).to.have.property(\"name\");",
              "    pm.expect(jsonData).to.have.property(\"job\");",
              "    pm.expect(jsonData).to.have.property(\"updatedAt\");",
              "});",
              "",
              "pm.test(\"Updated name is correct\", function () {",
              "    pm.expect(jsonData.name).to.eql(\"Aymane Jemmaa\");",
              "});",
              "",
              "pm.test(\"Updated job is correct\", function () {",
              "    pm.expect(jsonData.job).to.eql(\"Backend Developer\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "DELETE - Delete User",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{{user_id}}"
          ]
        },
        "description": "Delete an existing user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test(\"Response body is empty\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}